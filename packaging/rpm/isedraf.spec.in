Name:           isedraf
Version:        @VERSION@
# No %{?dist}: this is one noarch package for every supported release. The dist tag was
# inherited from the build host, so an RPM built on Fedora 44 installed on EL9 as ".fc44"
# (GA lifecycle proof, 2026-09-28).
Release:        @RELEASE@
Summary:        @DESCRIPTION@
License:        MPL-2.0
URL:            https://github.com/itcmsgr/isedraf
Source0:        isedraf-@FULLVERSION@.tar.gz
BuildArch:      noarch

# RPM's automatic dependency generator adds `Requires: /usr/bin/python3` on its own,
# from the Python source it finds in the payload. That single line would break exactly
# the platform this package was shaped around: a stock EL8 host has NO /usr/bin/python3
# and would be forced to install one, on a machine whose vendor interpreter at
# /usr/libexec/platform-python already runs ISEDRAF perfectly. The explicit boolean
# Requires below states the real dependency; the generator's guess is excluded.
%global __requires_exclude ^/usr/bin/python3$
%global __python_requires  %{nil}

# Either satisfies the runtime. A stock EL8 image ships no /usr/bin/python3 at all, yet
# always has a working vendor interpreter at /usr/libexec/platform-python because dnf
# itself needs one - so requiring python3 outright would install a runtime on a host that
# already has a perfectly good one.
Requires:       (python3 or platform-python)

# Deliberately NO BuildRequires. Nothing is compiled; %install uses `install`, which is
# present on any machine that can run rpmbuild at all. Declaring `BuildRequires: coreutils`
# made the build unsatisfiable on a Debian/Ubuntu builder, where rpmbuild exists but its
# rpm database has never heard of a package called coreutils:
#     error: Failed build dependencies: coreutils is needed by isedraf-...noarch
# It passed on a Fedora workstation, where the dependency happens to resolve. The release
# workflow runs on ubuntu-latest, so this would have broken the RPM for every release.

%description
ISEDRAF collects evidence about a local Linux host on demand: host and platform
inventory, local accounts and groups, NSS configuration, hostname, sudo, SSH server
configuration, PAM, login policy, mounts and SSH authorized keys. `isedraf audit`
normalizes what it collects and commits it as one evidence run in the invoking user's
own store, with the provenance of every fact and a hash-chained ledger record.
`isedraf report` renders a committed run - as a readable report, JSON or static HTML -
and never collects again.

This release runs unprivileged. Facts that need root are reported NOT_TESTED - not
observed, never passed. It makes no pass/fail judgement and does not compare runs.
Uninstalling the package does not remove collected evidence.

Python standard library only: no compiled component, no third-party runtime module, and
no interpreter is installed, bundled or downgraded by this package.

%prep
%setup -q -n isedraf-@FULLVERSION@

%build
# Intentionally empty. There is nothing to compile, and `python -m py_compile` would
# write .pyc files, which this project forbids shipping.

%install
install -d -m 0755 %{buildroot}%{_bindir} %{buildroot}%{_prefix}/lib/isedraf
install -m 0755 bin/isedraf %{buildroot}%{_bindir}/isedraf
cp -a lib/isedraf/. %{buildroot}%{_prefix}/lib/isedraf/
find %{buildroot}%{_prefix}/lib/isedraf -name '__pycache__' -prune -exec rm -rf {} + || :
find %{buildroot} -name '*.pyc' -delete || :
install -d -m 0755 %{buildroot}%{_docdir}/isedraf
install -m 0644 LICENSE %{buildroot}%{_docdir}/isedraf/LICENSE || :
install -m 0644 README.md %{buildroot}%{_docdir}/isedraf/README.md
# These two drifted: packaging/build.sh stages four documents, this section staged two,
# so an EL user received half the documentation a Debian user did. The %install section
# is a SECOND implementation of the payload and will drift again - check_package_payload.sh
# now compares the deb and rpm documentation sets against each other so that it cannot.
install -m 0644 docs/reference/PLATFORM_COMPATIBILITY.md \
    %{buildroot}%{_docdir}/isedraf/PLATFORM_COMPATIBILITY.md
install -m 0644 docs/operator/STORAGE_AND_OUTPUTS.md \
    %{buildroot}%{_docdir}/isedraf/STORAGE_AND_OUTPUTS.md
install -d -m 0755 %{buildroot}%{_docdir}/isedraf/docs
for guide in GETTING_STARTED EVIDENCE_MODEL AUDITOR_GUIDE REPORT_GUIDE SECURITY_AND_LIMITATIONS; do
    install -m 0644 docs/$guide.md %{buildroot}%{_docdir}/isedraf/docs/$guide.md
done

%files
%{_bindir}/isedraf
%{_prefix}/lib/isedraf
%doc %{_docdir}/isedraf

%changelog
* Thu Oct 08 2026 Antonios Voulvoulis <contact@itcms.gr> - @VERSION@-@RELEASE@
- 0.1.2, a correction release: incomplete collection is reported as not observed instead
  of absent or complete, and each audit records its evidence limits.

* Thu Oct 08 2026 Antonios Voulvoulis <contact@itcms.gr> - 0.1.2-0.rc1
- 0.1.2 release candidate: incomplete collection is reported as not observed instead of
  absent or complete, and each audit records its evidence limits.

* Tue Oct 06 2026 Antonios Voulvoulis <contact@itcms.gr> - 0.1.1-1
- 0.1.1, a correction release: an authorized_keys file that could not be examined is
  reported as not observed instead of absent.

* Tue Oct 06 2026 Antonios Voulvoulis <contact@itcms.gr> - 0.1.1-0.rc1
- 0.1.1 release candidate: an authorized_keys file that could not be examined is reported
  as not observed instead of absent.

* Mon Sep 28 2026 Antonios Voulvoulis <contact@itcms.gr> - 0.1.0-1
- 0.1.0, the first release: unprivileged evidence collection with isedraf audit, a
  user-mode evidence store, and Markdown, JSON and static HTML reports of a committed run.

* Mon Sep 28 2026 Antonios Voulvoulis <contact@itcms.gr> - 0.1.0-0.rc2
- A refused sudo run no longer leaves bytecode in the installed package directory.

* Mon Sep 28 2026 Antonios Voulvoulis <contact@itcms.gr> - 0.1.0-0.rc1
- 0.1 release candidate: unprivileged evidence collection with isedraf audit, a user-mode
  evidence store, and Markdown, JSON and static HTML reports of a committed run.

* Fri Sep 18 2026 Antonios Voulvoulis <contact@itcms.gr> - 0.1.0-0.alpha1
- Early technical preview: host identity, host inventory, report engine.
